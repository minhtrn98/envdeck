<Window x:Class="EnvDeck.App.MainWindow"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EnvDeck.App.ViewModels"
        xmlns:l="clr-namespace:EnvDeck.App.Localization"
        Title="{Binding Title}" Width="1240" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding Profiles.NewCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
        <!-- Windows 11 style on/off switch (the WPF Fluent theme has none built in). -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="6,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,6,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Column titles line up with the cell padding (CellPadding in App.xaml). -->
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="10,0,10,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,4" />
        </Style>
        <!-- Colors the +/−/~ marker of a compare row. -->
        <Style x:Key="DiffSymbol" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Foreground" Value="#2E9E4F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Foreground" Value="#D64545" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter Property="Foreground" Value="#D98A00" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr RestartAsAdmin}"
                        Command="{Binding RestartElevatedCommand}"
                        Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}"
                        ToolTip="{l:Tr RestartAsAdminTip}" />
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="10,6,10,6">

            <!-- ============================================================ PROFILES -->
            <TabItem Header="{l:Tr TabProfiles}" DataContext="{Binding Profiles}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="480" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{l:Tr ProfileFilterTip}" />
                        <Button DockPanel.Dock="Top" Command="{Binding NewCommand}" Margin="0,0,0,8"
                                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}"
                                ToolTip="{l:Tr NewProfileTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{l:Tr NewProfile}" />
                            </StackPanel>
                        </Button>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,0"
                                   Text="{l:Tr ProfileListHint}" />
                        <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.InputBindings>
                                <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
                                <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}" />
                                <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                            </ListBox.InputBindings>
                            <!-- Right-click selects the item under the cursor, so the menu acts on the selected profile.
                                 Living on the ListBox, it also opens with the Menu key / Shift+F10. -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Tr MenuRename}" InputGestureText="F2" Command="{Binding RenameCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:Tr MenuDuplicate}" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{l:Tr MenuDelete}" InputGestureText="Del" Command="{Binding DeleteCommand}"
                                              Foreground="{StaticResource DangerBrush}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                       Foreground="{StaticResource DangerBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                                    <DockPanel Margin="0,3">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                                      ToolTip="{l:Tr SwitchTip}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Turn {0} on or off}"
                                                      IsChecked="{Binding IsActive, Mode=OneWay}"
                                                      Checked="ProfileSwitch_Toggled" Unchecked="ProfileSwitch_Toggled" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch" Background="Transparent" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Editor, Converter={StaticResource NotNullToCollapsed}}">
                        <TextBlock Text="{l:Tr NoProfileSelected}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="420"
                                   Text="{l:Tr NoProfileHint}" />
                    </StackPanel>

                    <Grid Grid.Column="2" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header + actions -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="{l:Tr Save}" Command="{Binding SaveCommand}" Margin="0,0,6,0" MinWidth="80"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        ToolTip="{l:Tr SaveTip}" />
                                <Button Content="{l:Tr Discard}" Command="{Binding DiscardCommand}" MinWidth="80"
                                        ToolTip="{l:Tr DiscardTip}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Editor.Name}" FontSize="22" FontWeight="SemiBold" />
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                        Background="#2E9E4F"
                                        Visibility="{Binding Selected.IsActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:Tr OnBadge}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                </Border>
                                <TextBlock Text="{Binding Editor.Header}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Opacity="0.7" />
                                <TextBlock Text="{l:Tr Unsaved}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#D98A00"
                                           Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Metadata -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Tr Description}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="{l:Tr Group}" VerticalAlignment="Center" Margin="14,0,8,0"
                                       ToolTip="{l:Tr GroupTip}" />
                            <TextBox Grid.Column="3" Text="{Binding Editor.Group, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:Tr GroupTip}" />
                            <TextBlock Grid.Column="4" Text="{l:Tr Tags}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <TextBox Grid.Column="5" Text="{Binding Editor.Tags, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:Tr TagsTip}" />
                        </Grid>

                        <!-- Variable toolbar -->
                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="{l:Tr AddVariable}" Command="{Binding AddVariableCommand}" Margin="0,0,6,0" />
                                <Button Content="{l:Tr FromEnvironment}" Command="{Binding AddFromEnvironmentCommand}" Margin="0,0,6,0"
                                        ToolTip="{l:Tr FromEnvironmentTip}" />
                                <Button Content="{l:Tr RemoveVariable}" Command="{Binding RemoveVariableCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Text="{l:Tr VariablesHint}" ToolTip="{l:Tr VariablesHint}" />
                        </DockPanel>

                        <!-- Rows are reordered by dragging the grip in the first column (or Alt+Up / Alt+Down). -->
                        <DataGrid x:Name="VariablesGrid" Grid.Row="3" ItemsSource="{Binding Editor.Variables}"
                                  SelectedItem="{Binding SelectedVariable}" SelectionMode="Single"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                  AllowDrop="True" DragOver="VariablesGrid_DragOver" Drop="VariablesGrid_Drop"
                                  PreviewKeyDown="VariablesGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Cursor="SizeNS" ToolTip="{l:Tr DragToReorder}"
                                                    PreviewMouseLeftButtonDown="Grip_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="Grip_PreviewMouseMove">
                                                <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" Opacity="0.55"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridComboBoxColumn ElementStyle="{StaticResource CellCombo}" Header="{l:Tr ColScope}" Width="100"
                                                        ItemsSource="{x:Static vm:Options.Scopes}"
                                                        SelectedItemBinding="{Binding Scope, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridComboBoxColumn ElementStyle="{StaticResource CellCombo}" Header="{l:Tr ColOp}" Width="100"
                                                        ItemsSource="{x:Static vm:Options.Ops}"
                                                        SelectedItemBinding="{Binding Op, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColName}" Width="190"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColValue}" Width="*"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridComboBoxColumn ElementStyle="{StaticResource CellCombo}" Header="{l:Tr ColKind}" Width="140"
                                                        ItemsSource="{x:Static vm:Options.Kinds}"
                                                        SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColNote}" Width="150"
                                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Preview / history: collapsed by default so the variables get the room -->
                        <Expander Grid.Row="4" Header="{l:Tr PreviewAndHistory}" IsExpanded="False" Margin="0,10,0,0"
                                  HorizontalAlignment="Stretch">
                            <TabControl Height="230" Margin="0,6,0,0">
                                <TabItem Header="{l:Tr TabPreview}">
                                    <DockPanel Margin="0,6,0,0">
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Left" Content="{l:Tr PreviewChanges}"
                                                    Command="{Binding PreviewChangesCommand}"
                                                    ToolTip="{l:Tr PreviewChangesTip}" />
                                            <TextBlock Text="{Binding PreviewSummary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </DockPanel>
                                        <DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColAction}" Binding="{Binding Action}" Width="100" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColVariable}" Binding="{Binding Variable}" Width="200" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColBefore}" Binding="{Binding Before}" Width="*" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColAfter}" Binding="{Binding After}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{l:Tr TabHistory}">
                                    <DockPanel Margin="0,6,0,0">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="{l:Tr CompareWithCurrent}" Command="{Binding CompareVersionCommand}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="{l:Tr RollBackToVersion}" Command="{Binding RollbackCommand}" />
                                        </StackPanel>
                                        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedVersion}"
                                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColVersion}" Binding="{Binding Version, StringFormat=v{0}}" Width="90" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColSaved}" Width="200"
                                                                    Binding="{Binding SavedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColVariables}" Binding="{Binding VariableCount}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ ENVIRONMENT -->
            <TabItem Header="{l:Tr TabEnvironment}" DataContext="{Binding CurrentEnv}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:Tr CaptureSelected}" Command="{Binding CaptureCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=EnvGrid}"
                                    Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" />
                            <Button Content="{l:Tr CopyValue}" Command="{Binding CopyValueCommand}" Margin="6,0,0,0" />
                            <Button Content="{l:Tr BackupNow}" Command="{Binding BackupCommand}" Margin="6,0,0,0" />
                            <Button Content="{l:Tr Refresh}" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <ComboBox DockPanel.Dock="Left" Width="120" Margin="0,0,8,0"
                                  ItemsSource="{x:Static vm:Options.ScopeFilters}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ScopeFilter}" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr EnvFilterTip}" />
                    </DockPanel>
                    <DataGrid x:Name="EnvGrid" Grid.Row="1" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColScope}" Binding="{Binding Scope}" Width="90" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColName}" Binding="{Binding Name}" Width="240" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColValue}" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColKind}" Binding="{Binding Kind}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="0,10,0,4" Text="{l:Tr EntriesHint}" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Entries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry}" ToolTip="{Binding Expanded}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter Property="Foreground" Value="#D98A00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ============================================================ BACKUPS -->
            <TabItem Header="{l:Tr TabBackups}" DataContext="{Binding Backups}">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="{l:Tr BackupNow}" Command="{Binding CreateCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,6" />
                        <Button Content="{l:Tr RestoreSelected}" Command="{Binding RestoreCommand}" Margin="0,0,10,6" />
                        <CheckBox Content="{l:Tr ScopeUser}" IsChecked="{Binding RestoreUser}" Margin="0,0,6,6" />
                        <CheckBox Content="{l:Tr ScopeMachine}" IsChecked="{Binding RestoreMachine}" Margin="0,0,6,6" />
                        <CheckBox Content="{l:Tr PruneVariables}" IsChecked="{Binding Prune}" Margin="0,0,16,6" />
                        <Button Content="{l:Tr CompareWithCurrent}" Command="{Binding CompareWithCurrentCommand}" Margin="0,0,6,6" />
                        <Button Content="{l:Tr Delete}" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
                        <Button Content="{l:Tr OpenFolder}" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6" />
                        <Button Content="{l:Tr Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{l:Tr BackupsHint}" />
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColId}" Binding="{Binding Id}" Width="170" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColCreated}" Binding="{Binding Created}" Width="190" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColType}" Binding="{Binding Type}" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColNoteReason}" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColUser}" Binding="{Binding UserCount}" Width="80" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColMachine}" Binding="{Binding MachineCount}" Width="100" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColHost}" Binding="{Binding Host}" Width="140" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColProfilesOn}" Binding="{Binding ActiveProfiles}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ COMPARE -->
            <TabItem Header="{l:Tr TabCompare}" DataContext="{Binding Compare}">
                <DockPanel Margin="0,10,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" ItemsSource="{Binding Sources}"
                                  Text="{Binding Left, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr LeftTip}" />
                        <Button Grid.Column="1" Content="⇄" Command="{Binding SwapCommand}" Margin="6,0" ToolTip="{l:Tr Swap}" />
                        <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding Sources}"
                                  Text="{Binding Right, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr RightTip}" />
                        <CheckBox Grid.Column="3" Content="{l:Tr ShowUnchanged}" IsChecked="{Binding ShowSame}" Margin="12,0,6,0" />
                        <Button Grid.Column="4" Content="{l:Tr Compare}" Command="{Binding RunCommand}"
                                Style="{DynamicResource AccentButtonStyle}" MinWidth="96" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Symbol}" Style="{StaticResource DiffSymbol}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColVariable}" Binding="{Binding Variable}" Width="220" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColLeft}" Binding="{Binding Left}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColRight}" Binding="{Binding Right}" Width="*" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColListEntries}" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ SEARCH -->
            <TabItem Header="{l:Tr TabSearch}" DataContext="{Binding Search}">
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr Search}" Command="{Binding RunCommand}"
                                Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr SearchTip}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RunCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox Content="{l:Tr InNames}" IsChecked="{Binding InNames}" Margin="0,0,6,0" />
                        <CheckBox Content="{l:Tr InValues}" IsChecked="{Binding InValues}" Margin="0,0,6,0" />
                        <CheckBox Content="{l:Tr Regex}" IsChecked="{Binding UseRegex}" Margin="0,0,24,0" />
                        <CheckBox Content="{l:Tr InProfiles}" IsChecked="{Binding InProfiles}" Margin="0,0,6,0" />
                        <CheckBox Content="{l:Tr InEnvironment}" IsChecked="{Binding InEnvironment}" Margin="0,0,6,0" />
                        <CheckBox Content="{l:Tr InBackups}" IsChecked="{Binding InBackups}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding Summary}" />
                    <DataGrid x:Name="SearchGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" MouseDoubleClick="SearchGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColSource}" Binding="{Binding Source}" Width="200" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColVariable}" Binding="{Binding Variable}" Width="240" />
                            <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColValue}" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ SETTINGS -->
            <TabItem Header="{l:Tr TabSettings}" DataContext="{Binding Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,16" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="{l:Tr Language}" Style="{StaticResource Heading}" />
                        <ComboBox HorizontalAlignment="Left" MinWidth="200"
                                  ItemsSource="{x:Static l:Loc.Languages}" DisplayMemberPath="Name"
                                  SelectedValuePath="Code" SelectedValue="{Binding Language}" />

                        <TextBlock Text="{l:Tr DataFolder}" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{l:Tr DataFolderHint}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Tr Browse}" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding DataDir, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <TextBlock Text="{l:Tr VersionsKept}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding HistoryLimit, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,24,0" />
                            <CheckBox Content="{l:Tr AutoBackupKeep}" IsChecked="{Binding AutoBackup}" Margin="0,0,8,0" />
                            <TextBox Text="{Binding AutoBackupLimit, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{l:Tr SaveSettings}" Command="{Binding SaveCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0" />
                            <Button Content="{l:Tr OpenDataFolder}"
                                    Command="{Binding DataContext.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                        <TextBlock Text="{l:Tr MoveMachine}" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{l:Tr MoveMachineHint}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Tr ExportBundle}" Command="{Binding ExportCommand}" Margin="0,0,6,0" />
                            <Button Content="{l:Tr ImportBundle}" Command="{Binding ImportCommand}" />
                        </StackPanel>

                        <TextBlock Text="{l:Tr Doctor}" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{l:Tr DoctorHint}" />
                        <Button Content="{l:Tr RunDoctor}" Command="{Binding RunDoctorCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Severity}" Width="80" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

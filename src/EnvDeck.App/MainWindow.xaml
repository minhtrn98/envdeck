<Window x:Class="EnvDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EnvDeck.App.ViewModels"
        Title="{Binding Title}" Width="1240" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,4" />
        </Style>
        <!-- Colors the +/−/~ marker of a compare row. -->
        <Style x:Key="DiffSymbol" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter Property="Foreground" Value="#2E9E4F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter Property="Foreground" Value="#D64545" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                    <Setter Property="Foreground" Value="#D98A00" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator"
                        Command="{Binding RestartElevatedCommand}"
                        Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}"
                        ToolTip="Needed only to change Machine (all users) variables" />
                <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="10,6,10,6">

            <!-- ============================================================ PROFILES -->
            <TabItem Header="Profiles" DataContext="{Binding Profiles}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="480" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by name, description, group or tag" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,6,6"
                                    Style="{DynamicResource AccentButtonStyle}" />
                            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,6,6" />
                            <Button Content="Rename" Command="{Binding RenameCommand}" Margin="0,0,6,6" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                                    <DockPanel Margin="0,3">
                                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="0"
                                                  Margin="0,0,4,0" ToolTip="Turn on / off"
                                                  IsChecked="{Binding IsActive, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch" Background="Transparent" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Editor, Converter={StaticResource NotNullToCollapsed}}">
                        <TextBlock Text="No profile selected" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="420"
                                   Text="Create one with New, or capture existing variables from the Environment tab." />
                    </StackPanel>

                    <Grid Grid.Column="2" Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="230" />
                        </Grid.RowDefinitions>

                        <!-- Header + actions -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="{Binding ToggleText}" Command="{Binding ToggleActiveCommand}"
                                        Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="0,0,6,0"
                                        ToolTip="Write this profile to the Windows environment, or undo it" />
                                <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0"
                                        ToolTip="Save as a new version" />
                                <Button Content="Discard" Command="{Binding DiscardCommand}" Margin="0,0,6,0" />
                                <Button Content="Open JSON" Command="{Binding OpenJsonCommand}" Margin="0,0,6,0" />
                                <Button Content="Copy shell cmd" Command="{Binding CopyShellCommandCommand}"
                                        ToolTip="envdeck shell NAME | Invoke-Expression: load the profile into one terminal only" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Editor.Name}" FontSize="22" FontWeight="SemiBold" />
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                        Background="#2E9E4F"
                                        Visibility="{Binding Selected.IsActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ON" Foreground="White" FontWeight="Bold" FontSize="11" />
                                </Border>
                                <TextBlock Text="{Binding Editor.Header}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Opacity="0.7" />
                                <TextBlock Text="● unsaved" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#D98A00"
                                           Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Metadata -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Description" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="Group" VerticalAlignment="Center" Margin="14,0,8,0"
                                       ToolTip="Profiles in the same group replace each other when turned on (e.g. java)" />
                            <TextBox Grid.Column="3" Text="{Binding Editor.Group, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Profiles in the same group replace each other when turned on (e.g. java)" />
                            <TextBlock Grid.Column="4" Text="Tags" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <TextBox Grid.Column="5" Text="{Binding Editor.Tags, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Comma separated" />
                        </Grid>

                        <!-- Variable toolbar -->
                        <DockPanel Grid.Row="2" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="Add variable" Command="{Binding AddVariableCommand}" Margin="0,0,6,0" />
                                <Button Content="From environment…" Command="{Binding AddFromEnvironmentCommand}" Margin="0,0,6,0"
                                        ToolTip="Pick variables, or single Path entries, from the current environment" />
                                <Button Content="Remove" Command="{Binding RemoveVariableCommand}" Margin="0,0,6,0" />
                                <Button Content="↑" Command="{Binding MoveUpCommand}" Margin="0,0,6,0" ToolTip="Move up" />
                                <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Move down" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Text="Prepend/Append add ';'-separated entries to Path-like variables · %VAR% references are kept · Machine scope needs admin" />
                        </DockPanel>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding Editor.Variables}"
                                  SelectedItem="{Binding SelectedVariable}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Scope" Width="100"
                                                        ItemsSource="{x:Static vm:Options.Scopes}"
                                                        SelectedItemBinding="{Binding Scope, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridComboBoxColumn Header="Op" Width="100"
                                                        ItemsSource="{x:Static vm:Options.Ops}"
                                                        SelectedItemBinding="{Binding Op, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Name" Width="190"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Value" Width="*"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridComboBoxColumn Header="Kind" Width="120"
                                                        ItemsSource="{x:Static vm:Options.Kinds}"
                                                        SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Note" Width="150"
                                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Preview / history -->
                        <TabControl Grid.Row="4" Margin="0,10,0,0">
                            <TabItem Header="Preview">
                                <DockPanel Margin="0,6,0,0">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Left" Content="Preview changes"
                                                Command="{Binding PreviewChangesCommand}"
                                                ToolTip="What turning this profile on would change (unsaved edits included)" />
                                        <TextBlock Text="{Binding PreviewSummary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90" />
                                            <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="200" />
                                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="*" />
                                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="History">
                                <DockPanel Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Compare with current" Command="{Binding CompareVersionCommand}"
                                                Margin="0,0,6,0" />
                                        <Button Content="Roll back to this version" Command="{Binding RollbackCommand}" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedVersion}"
                                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Version" Binding="{Binding Version, StringFormat=v{0}}" Width="90" />
                                            <DataGridTextColumn Header="Saved" Width="200"
                                                                Binding="{Binding SavedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                            <DataGridTextColumn Header="Variables" Binding="{Binding VariableCount}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ ENVIRONMENT -->
            <TabItem Header="Environment" DataContext="{Binding CurrentEnv}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Capture selected → profile" Command="{Binding CaptureCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=EnvGrid}"
                                    Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" />
                            <Button Content="Copy value" Command="{Binding CopyValueCommand}" Margin="6,0,0,0" />
                            <Button Content="Backup now" Command="{Binding BackupCommand}" Margin="6,0,0,0" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <ComboBox DockPanel.Dock="Left" Width="120" Margin="0,0,8,0"
                                  ItemsSource="{x:Static vm:Options.ScopeFilters}" SelectedItem="{Binding ScopeFilter}" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by name or value" />
                    </DockPanel>
                    <DataGrid x:Name="EnvGrid" Grid.Row="1" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Style="{StaticResource Hint}" Margin="0,10,0,4"
                               Text="Entries of the selected list variable (orange = folder not found). Note: Windows puts the Machine Path before the User Path." />
                    <ListBox Grid.Row="3" ItemsSource="{Binding Entries}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Entry}" ToolTip="{Binding Expanded}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter Property="Foreground" Value="#D98A00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ============================================================ BACKUPS -->
            <TabItem Header="Backups" DataContext="{Binding Backups}">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Backup now" Command="{Binding CreateCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,6" />
                        <Button Content="Restore selected" Command="{Binding RestoreCommand}" Margin="0,0,10,6" />
                        <CheckBox Content="User" IsChecked="{Binding RestoreUser}" Margin="0,0,6,6" />
                        <CheckBox Content="Machine" IsChecked="{Binding RestoreMachine}" Margin="0,0,6,6" />
                        <CheckBox Content="Delete variables not in the backup" IsChecked="{Binding Prune}" Margin="0,0,16,6" />
                        <Button Content="Compare with current" Command="{Binding CompareWithCurrentCommand}" Margin="0,0,6,6" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="A backup is taken automatically before every turn on/off and restore (only the most recent automatic ones are kept). Manual backups stay until you delete them. Before reinstalling Windows: Settings → Export bundle (with backups)." />
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="150" />
                            <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="150" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                            <DataGridTextColumn Header="Note / reason" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="User" Binding="{Binding UserCount}" Width="60" />
                            <DataGridTextColumn Header="Machine" Binding="{Binding MachineCount}" Width="80" />
                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" />
                            <DataGridTextColumn Header="Profiles on" Binding="{Binding ActiveProfiles}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ COMPARE -->
            <TabItem Header="Compare" DataContext="{Binding Compare}">
                <DockPanel Margin="0,10,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox IsEditable="True" ItemsSource="{Binding Sources}"
                                  Text="{Binding Left, UpdateSourceTrigger=PropertyChanged}" ToolTip="Left (old)" />
                        <Button Grid.Column="1" Content="⇄" Command="{Binding SwapCommand}" Margin="6,0" ToolTip="Swap" />
                        <ComboBox Grid.Column="2" IsEditable="True" ItemsSource="{Binding Sources}"
                                  Text="{Binding Right, UpdateSourceTrigger=PropertyChanged}" ToolTip="Right (new)" />
                        <CheckBox Grid.Column="3" Content="Show unchanged" IsChecked="{Binding ShowSame}" Margin="12,0,6,0" />
                        <Button Grid.Column="4" Content="Compare" Command="{Binding RunCommand}"
                                Style="{DynamicResource AccentButtonStyle}" MinWidth="96" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Symbol}" Style="{StaticResource DiffSymbol}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="220" />
                            <DataGridTextColumn Header="Left" Binding="{Binding Left}" Width="*" />
                            <DataGridTextColumn Header="Right" Binding="{Binding Right}" Width="*" />
                            <DataGridTextColumn Header="List entries" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ SEARCH -->
            <TabItem Header="Search" DataContext="{Binding Search}">
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Search" Command="{Binding RunCommand}"
                                Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Text (or regular expression) to find in variable names and values">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RunCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox Content="Names" IsChecked="{Binding InNames}" Margin="0,0,6,0" />
                        <CheckBox Content="Values" IsChecked="{Binding InValues}" Margin="0,0,6,0" />
                        <CheckBox Content="Regex" IsChecked="{Binding UseRegex}" Margin="0,0,24,0" />
                        <CheckBox Content="Profiles" IsChecked="{Binding InProfiles}" Margin="0,0,6,0" />
                        <CheckBox Content="Environment" IsChecked="{Binding InEnvironment}" Margin="0,0,6,0" />
                        <CheckBox Content="Backups" IsChecked="{Binding InBackups}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{Binding Summary, StringFormat={}{0}  ·  double-click a row to open it}" />
                    <DataGrid x:Name="SearchGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" MouseDoubleClick="SearchGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="200" />
                            <DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="240" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ SETTINGS -->
            <TabItem Header="Settings &amp; tools" DataContext="{Binding Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,16" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Data folder" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Profiles, version history and backups. Point it at OneDrive or a git repository to keep them in sync between machines. Empty = %USERPROFILE%\.envdeck" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding DataDir, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <WrapPanel Margin="0,14,0,0">
                            <TextBlock Text="Versions kept per profile" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding HistoryLimit}" Width="80" Margin="0,0,24,0" />
                            <CheckBox Content="Automatic backup before changes, keep" IsChecked="{Binding AutoBackup}" Margin="0,0,8,0" />
                            <TextBox Text="{Binding AutoBackupLimit}" Width="80" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save settings" Command="{Binding SaveCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0" />
                            <Button Content="Open data folder"
                                    Command="{Binding DataContext.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                        <TextBlock Text="Move to another machine / reinstall Windows" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Export bundles every profile with its full history (and optionally backups) into one .zip. On the new machine: install EnvDeck, Import, then turn the profiles you need on. Use 'Capture → portable' so paths such as C:\Users\you become %USERPROFILE%." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export bundle…" Command="{Binding ExportCommand}" Margin="0,0,6,0" />
                            <Button Content="Import bundle or profile…" Command="{Binding ImportCommand}" />
                        </StackPanel>

                        <TextBlock Text="Doctor" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Checks Path for missing and duplicate folders, profiles for errors, and profiles that are on but were changed outside EnvDeck." />
                        <Button Content="Run doctor" Command="{Binding RunDoctorCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Severity}" Width="70" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

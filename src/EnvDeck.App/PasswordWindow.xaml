<Window x:Class="EnvDeck.App.PasswordWindow"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:EnvDeck.App.Localization"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <PasswordBox x:Name="First" />
        <TextBlock x:Name="RepeatLabel" Text="{l:Tr PasswordRepeat}" Margin="0,12,0,8" Visibility="Collapsed" />
        <PasswordBox x:Name="Second" Visibility="Collapsed" />
        <TextBlock x:Name="NoteText" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#E5484D" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Tr Ok}" IsDefault="True" MinWidth="90" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{l:Tr Cancel}" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>

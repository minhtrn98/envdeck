<Window x:Class="EnvDeck.App.EnvPickerWindow"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EnvDeck.App.ViewModels"
        xmlns:l="clr-namespace:EnvDeck.App.Localization"
        Title="{l:Tr PickerTitle}" Width="1060" Height="660" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Column titles line up with the cell padding (CellPadding in App.xaml). -->
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Template" Value="{StaticResource ColumnHeaderTemplate}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Left" Width="120" Margin="0,0,8,0"
                      ItemsSource="{x:Static vm:Options.ScopeFilters}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding ScopeFilter}" />
            <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{l:Tr EnvFilterTip}" />
        </DockPanel>

        <TextBlock Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{l:Tr PickerHint}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Current}" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:PickVariable}">
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" VerticalAlignment="Center"
                                          HorizontalAlignment="Center" ToolTip="{l:Tr AddWholeValueTip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColScope}" Binding="{Binding Scope}" Width="100" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColName}" Binding="{Binding Name}" Width="190" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColValue}" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{l:Tr ColAddsAs}" Binding="{Binding Mode}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"
                           Text="{Binding EntriesTitle}" />
                <TextBlock DockPanel.Dock="Top" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="{l:Tr PickerEntriesHint}" />
                <ListBox ItemsSource="{Binding Current.Entries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PickEntry}">
                            <CheckBox IsChecked="{Binding IsChecked}" ToolTip="{Binding Entry}">
                                <TextBlock Text="{Binding Entry}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                                    <Setter Property="Foreground" Value="#D98A00" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Tr AddToProfile}" IsDefault="True" MinWidth="120" Click="Add_Click"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="{l:Tr Cancel}" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
            <CheckBox Content="{l:Tr PortablePaths}" IsChecked="{Binding Portable}"
                      VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.7" />
        </DockPanel>
    </Grid>
</Window>

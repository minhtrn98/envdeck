<Window x:Class="EnvDeck.App.PromptWindow"
        FontFamily="{StaticResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:EnvDeck.App.Localization"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ComboBox x:Name="Input" IsEditable="True" IsTextSearchEnabled="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:Tr Ok}" IsDefault="True" MinWidth="90" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{l:Tr Cancel}" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>

<Application x:Class="EnvDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:EnvDeck.App"
             ThemeMode="System">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <app:NullToCollapsedConverter x:Key="NotNullToCollapsed" Invert="True" />

        <!-- Windows set FontFamily to AppFont; overriding the theme key also covers the Fluent control styles. -->
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>

        <!-- DataGrid cells: the default column styles leave text at the top of the row with almost no padding.
             Each window's implicit DataGridColumnHeader style gives headers the same padding so titles line up. -->
        <Thickness x:Key="CellPadding">10,6,10,6</Thickness>
        <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="{StaticResource CellPadding}" />
        </Style>
        <!-- The editor of a text cell: same left edge and height as the TextBlock it replaces, so the text does not jump. -->
        <Style x:Key="CellTextEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <!-- The theme's input fill is translucent, so on a selected row it takes that row's tint (purple). Use the opaque one. -->
            <Style.Resources>
                <!-- Square, so the editor covers the whole cell instead of leaving a rounded rim of the cell showing. -->
                <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource SolidBackgroundFillColorBase}" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource SolidBackgroundFillColorBase}" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource SolidBackgroundFillColorBase}" />
            </Style.Resources>
            <Setter Property="Margin" Value="-1,-1,-1,-2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="9,6,10,8" />
        </Style>
        <!-- A ComboBox that lives in a grid cell looks like the text cells around it: no box, no fill, just the value and a
             chevron, with a faint highlight on hover. Its own template (the theme's one colours the text per state, which
             is unreadable on a selected row); the popup uses the theme's brushes, so it follows light/dark. -->
        <Style x:Key="CellCombo" TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0,8,0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- Same colour as the text cells around it (there is no theme style under this template to supply one). -->
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Face" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#1A808080" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#26808080" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ComboBoxDropDownBackground}"
                                        BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="0,4" Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Toggle" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The selected row is a light accent tint in both themes. -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#1B1B1B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>

<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Debug runs through the signed dotnet.exe ("dotnet x.dll") instead of a freshly built, unsigned
         x.exe, which execution policies (AppLocker, Defender ASR) often block. Release still ships the .exe. -->
    <UseAppHost Condition="'$(Configuration)' != 'Release'">false</UseAppHost>
    <!-- MSBuild turns environment variables into properties, and the SDK appends $(PublicKey) to every
         InternalsVisibleTo. A machine-wide PublicKey variable (used by other apps) would break ours (CS1700);
         EnvDeck is not strong-name signed, so pin it to empty. -->
    <PublicKey></PublicKey>

    <Version>0.4.3</Version>
    <Product>EnvDeck</Product>
    <Authors>Trần Công Minh</Authors>
    <Copyright>Copyright (c) 2026 Trần Công Minh</Copyright>
    <Description>Profile-based Windows environment variable manager.</Description>
    <RepositoryUrl>https://github.com/minhtrn98/envdeck</RepositoryUrl>
  </PropertyGroup>
</Project>
